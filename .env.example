# Copy this file to ".env" (same folder as the script that needs it) and fill in
# your real keys. NEVER commit the real .env — it is gitignored on purpose.
#
#   cp .env.example .env
#
# Get keys from:
#   Groq      -> https://console.groq.com/keys        (starts with gsk_)
#   OpenAI    -> https://platform.openai.com/api-keys  (starts with sk-)
#   Anthropic -> https://console.anthropic.com/        (starts with sk-ant-)
#   Google    -> https://aistudio.google.com/app/apikey

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
